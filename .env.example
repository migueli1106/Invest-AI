PORT=8080

# 2. Firebase (Base de Datos Firestore & Auth)
FIREBASE_PROJECT_ID=invest-ai-509415

# 3. Google Cloud Storage (Multimedia & Reportes)
GCS_REPORTS_BUCKET=invest-ai-reports-509415
