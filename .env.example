# ==============================================================================
# 🔒 INVEST AI - PLANTILLA ZERO-TRUST DE VARIABLES DE ENTORNO
# ==============================================================================

# 1. Google Cloud Platform (Servidor & Infraestructura)
GCP_PROJECT_ID=invest-ai-509416
GCP_REGION=us-central1
PORT=8080

# 2. Firebase (Base de Datos Firestore & Auth)
FIREBASE_PROJECT_ID=invest-ai-509416
FIRESTORE_DATABASE_ID=invest-ai

# 3. Google Cloud Storage (Multimedia & Reportes)
GCS_BUCKET_NAME=invest_ia
GCS_REPORTS_PREFIX=reports/
GCS_MEDIA_PREFIX=media/

# 4. Meta Cloud API (WhatsApp Business - Aprobación en un Clic)
# Obtén estos datos en: developers.facebook.com -> WhatsApp -> API Setup
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_VERIFY_TOKEN=invest_ai_secret_token
ADMIN_WHATSAPP_NUMBER=

# 5. Broker Gateway (Alpaca / Simulación / Happi)
BROKER_ENVIRONMENT=paper
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# 6. Canal de Notificación Secundario (Opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 7. Entorno de Ejecución
NODE_ENV=development
