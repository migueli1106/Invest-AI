# ==============================================================================
# 🔒 INVEST AI - PLANTILLA ZERO-TRUST DE VARIABLES DE ENTORNO
# ==============================================================================

# 1. Google Cloud Platform (Servidor & Infraestructura)
GCP_PROJECT_ID=invest-ai-509416
GCP_REGION=us-central1
PORT=8080

# 2. Firebase (Base de Datos Firestore & Auth)
FIREBASE_PROJECT_ID=invest-ai-509416
FIRESTORE_DATABASE_ID=invest-ai

# 3. Google Cloud Storage (Multimedia & Reportes)
GCS_BUCKET_NAME=invest_ia
GCS_REPORTS_PREFIX=reports/
GCS_MEDIA_PREFIX=media/

# 4. Twilio WhatsApp API (Human-in-the-Loop Gateway Principal)
# Obtén estos datos en: twilio.com/console -> WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
ADMIN_WHATSAPP_NUMBER=

# 5. Meta Cloud API (WhatsApp Business - Opcional / Canal Alternativo)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_VERIFY_TOKEN=invest_ai_secret_token

# 6. Broker Gateway (Moomoo OpenAPI Principal)
PRIMARY_BROKER=Moomoo
BROKER_ENVIRONMENT=SIMULATE

# 7. Canal de Notificación Secundario (Opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 8. Google Cloud Scheduler (Piloto Automático 24/7)
CRON_SECRET=invest_ai_cron_internal_secret

# 9. Broker Execution Bridge (MOOMOO | COPILOT | LOCAL_AGENT)
EXECUTION_MODE=MOOMOO
BRIDGE_SECRET=invest_ai_bridge_internal_secret

# 10. Moomoo OpenAPI & OpenD Gateway
MOOMOO_ACC_ID=2886044
MOOMOO_TRD_ENV=SIMULATE
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111

# 11. Worker Residencial de Automatización Local
CLOUD_RUN_URL=https://invest-ai-engine-891662254338.us-central1.run.app
LOCAL_CHROME_PATH=
LOCAL_CHROME_PROFILE_DIR=./.hapi-profile

# 12. Entorno de Ejecución
NODE_ENV=development
